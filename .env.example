# ─── Discord Bot ─────────────────────────────────────────────
# Portail développeur Discord > ton application > Bot > Token
DISCORD_BOT_TOKEN=

# Portail développeur Discord > ton application > General Information > Application ID
DISCORD_CLIENT_ID=

# Portail développeur Discord > ton application > OAuth2 > Client Secret
DISCORD_CLIENT_SECRET=

# URL publique de callback OAuth2 du dashboard (à ajouter aussi dans le portail Discord)
# Exemple en local : http://localhost:3000/auth/callback
# Exemple sur Render : https://ton-app.onrender.com/auth/callback
DISCORD_REDIRECT_URI=http://localhost:3000/auth/callback

# Liste des IDs Discord (séparés par des virgules) autorisés à se connecter au dashboard.
# Tu peux aussi les gérer plus tard directement depuis le dashboard une fois connecté.
ADMIN_DISCORD_IDS=

# ─── Base de données ─────────────────────────────────────────
# URI de connexion MongoDB Atlas (voir README pour la création du cluster gratuit)
MONGODB_URI=

# ─── Dashboard / Session ─────────────────────────────────────
# Chaîne aléatoire longue et secrète, sert à signer les cookies de session.
# Génère-en une avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Port sur lequel Express écoute (Render fournit automatiquement PORT, ne pas y toucher sur Render)
PORT=3000

# URL publique complète de ton service (utile pour générer les liens OAuth correctement)
PUBLIC_URL=http://localhost:3000

# ─── IA (optionnel) ───────────────────────────────────────────
# Clé API Gemini (Google AI Studio), gratuite. Sans elle, le bouton
# "Question IA" reste visible dans les tickets mais renvoie une erreur claire.
GEMINI_API_KEY=

# Optionnel, modèle Gemini à utiliser (voir README pour la liste à jour).
GEMINI_MODEL=gemini-2.0-flash
